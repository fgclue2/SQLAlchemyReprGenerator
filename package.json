{
  "name": "sqlalchemyrepr",
  "displayName": "SQLAlchemy __repr__() Generator",
  "description": "Generates __repr__() functions for SQLAlchemy's ORM",
  "icon": "icon.png",
  "version": "1.0.1",
  "publisher": "fgclue",
  "engines": {
    "vscode": "^1.114.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "sqlalchemyrepr.reprgenerate",
        "title": "SQLAlchemy: Create __repr__() string"
      },
      {
        "command": "sqlalchemyrepr.boilergenerate",
        "title": "SQLAlchemy: Create full __repr()__ boilerplate"
      }
    ]
  },
  "repository": "https://github.com/fgclue2/SQLAlchemyReprGenerator",
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.114.0",
    "@types/mocha": "^10.0.8",
    "@types/node": "20.x",
    "@typescript-eslint/eslint-plugin": "^8.7.0",
    "@typescript-eslint/parser": "^8.7.0",
    "eslint": "^9.11.1",
    "typescript": "^5.6.2",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.4.1"
  }
}
